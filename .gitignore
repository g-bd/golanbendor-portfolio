# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/

# markdown files (except README.md)
*.md
!README.md

# old folder
old/

# sensitive files
public/api-keys-*.csv
*.csv

# temp files
tmpclaude-*
.playwright-mcp/
.playwright-cli/

# large media (not tracked in git)
public/hi res photos/
public/*.mp4
# web-compressed versions are small enough to track
!public/*-web.mp4
"public/The Istrc21*"
